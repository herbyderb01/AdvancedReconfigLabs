DEPTH = 1024;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;
CONTENT
BEGIN

000 : 04200000; --        LW      R1, n(R0)          ; load starting value n
001 : 0CA10000; --        ADD     R5, R1, R0         ; value = n
002 : ACA00012; --        BEQZ    R5, onecase        ; if n == 0 -> factorial = 1
003 : 20A50001; --        SUBI    R5, R5, 1          ; value = n - 1
004 : ACA00012; --        BEQZ    R5, onecase        ; if n == 1 -> factorial = 1
005 : 0C610000; --        ADD     R3, R1, R0         ; result = n
006 : 0C850000; --        ADD     R4, R5, R0         ; count = value
007 : 20A50001; --        SUBI    R5, R5, 1          ; value--
008 : ACA00014; --        BEQZ    R5, done
009 : 0C430000; --        ADD     R2, R3, R0         ; hold = result (save old result)
00A : BC00000C; --        JAL     f_multiply         ; result = result * count (via repeated add)
00B : B4000006; --        J       loop1              ; continue outer loop (next multiply)
00C : 0C631000; --        ADD     R3, R3, R2         ; result += hold
00D : 20840002; --        SUBI    R4, R4, 2          ; count -= 2  (paired with fix to net -1)
00E : B0800010; --        BNEZ    R4, fix            ; if count != 0, keep going
00F : BBE00000; --        JR      R31                ; if count == 0, return to caller
010 : 10840001; --        ADDI    R4, R4, 1          ; net effect: count--
011 : B400000C; --        J       f_multiply         ; keep multiplying (repeated addition)
012 : 10600001; --        ADDI    R3, R0, 1          ; factorial(0) or factorial(1) = 1
013 : B4000014; --        J       done
014 : 08600001; --        SW      f(R0), R3          ; store factorial result in f
015 : 10C00000; --        ADDI R6, R0, 0             ; set R6 to 0
016 : 10E00000; --        ADDI R7, R0, 0             ; set R7 to 0
017 : 11000025; --        ADDI R8, R0, 37            ; set R7 to 0
018 : 1280000A; --        ADDI R20, R0, 10
019 : 95E74000; --        SGEU R15, R7, R8           ; Loop 37 times
01A : B1E00020; --        BNEZ R15, endresult
01B : 10E70001; --        ADDI R7, R7, 1
01C : 05460002; --        LW R10, s1(R6)             
01D : 10C60001; --	ADDI R6, R6, 1             
01E : C5400000; --	PCH R10
01F : B4000019; --        J       endtitleloop
020 : C6800000; --        PCH R20
021 : C8200000; --        PD R1
022 : 10E00000; --        ADDI R7, R0, 0             ; set R7 to 0
023 : 11000004; --        ADDI R8, R0, 4             ; set R8 to 4
024 : 10C00000; --        ADDI R6, R0, 0             ; set R6 to 0
025 : 95E74000; --        SGEU R15, R7, R8           ; Loop 4 times
026 : B1E0002C; --        BNEZ R15, printendresult
027 : 10E70001; --        ADDI R7, R7, 1
028 : 05460027; --        LW R10, s2(R6)             
029 : 10C60001; --	ADDI R6, R6, 1             
02A : C5400000; --	PCH R10
02B : B4000025; --        J       endresultloop
02C : 04600001; --        LW R3, f(R0)
02D : 106000F0; --        ADDI R3, R0, 240             ; set R3 to 240
02E : 03FFF800; --        NOP
02F : 03FFF800; --        NOP
030 : CC600000; --        PDU R3
031 : B4000031; --        J end

END;
