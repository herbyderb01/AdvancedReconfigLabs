DEPTH = 1024;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;
CONTENT
BEGIN

000 : 04200000; --        LW      R1, n(R0)          ; load starting value n
001 : 0CA10000; --        ADD     R5, R1, R0         ; value = n
002 : ACA00013; --        BEQZ    R5, onecase        ; if n == 0 -> factorial = 1
003 : 20A50001; --        SUBI    R5, R5, 1          ; value = n - 1
004 : ACA00013; --        BEQZ    R5, onecase        ; if n == 1 -> factorial = 1
005 : 0C610000; --        ADD     R3, R1, R0         ; result = n
006 : 20A50001; --        SUBI R5, R5, 1
007 : 0C850000; --        ADD R4, R5, R0
008 : 10840001; --        ADDI R4, R4, 1
009 : ACA00015; --        BEQZ    R5, done
00A : 0C430000; --        ADD     R2, R3, R0         ; hold = result (save old result)
00B : BC00000D; --        JAL     f_multiply         ; result = result * count (via repeated add)
00C : B4000006; --        J       loop1              ; continue outer loop (next multiply)
00D : 0C631000; --        ADD     R3, R3, R2         ; result += hold
00E : 20840002; --        SUBI    R4, R4, 2          ; count -= 2  (paired with fix to net -1)
00F : B0800011; --        BNEZ    R4, fix            ; if count != 0, keep going
010 : BBE00000; --        JR      R31                ; if count == 0, return to caller
011 : 10840001; --        ADDI    R4, R4, 1          ; net effect: count--
012 : B400000D; --        J       f_multiply         ; keep multiplying (repeated addition)
013 : 10600001; --        ADDI    R3, R0, 1          ; factorial(0) or factorial(1) = 1
014 : B4000015; --        J       done
015 : 08600001; --        SW      f(R0), R3          ; store factorial result in f

END;
