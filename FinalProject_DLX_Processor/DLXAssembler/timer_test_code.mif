DEPTH = 1024;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;
CONTENT
BEGIN

000 : D8000000; --    TR
001 : DC000000; --    TGO
002 : 10200000; --    ADDI R1, R0, 0
003 : 10210001; --    ADDI R1, R1, 1
004 : 10400000; --    ADDI R2, R0, 0
005 : 10420001; --    ADDI R2, R2, 1
006 : 60622710; --    SLTI R3, R2, 10000
007 : B0600005; --    BNEZ R3, inner
008 : 60612710; --    SLTI R3, R1, 10000
009 : B0600003; --    BNEZ R3, outer
00A : E0000000; --    TSP
00B : B400000B; --    J done

END;
