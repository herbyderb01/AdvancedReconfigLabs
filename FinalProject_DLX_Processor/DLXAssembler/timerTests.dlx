.text                                                              
      TR
      TGO                                                              
      ADDI R1, R0, 0
  loop                                                                 
      ADDI R1, R1, 1                                                 
      SLTI R2, R1, 10000
      BNEZ R2, loop                                                    
      TSP
  done                                                                 
      J done