.data
;ending value for factorial
f   1   0
.const
s1 37 "Welcome to the DLX factorial program!"
s2 16 "Enter a number: "
s3 4 "! = "

;R1 = user input (n)
;R2 = hold variable (for multiply)
;R3 = result variable
;R4 = count variable (for multiply)
;R5 = value variable (loop counter)
;R6 = data memory offset for string printing
;R7 = string loop counter
;R8 = string length
;R10 = temp char for PCH
;R15 = comparison result
;R20 = newline character (10)

.text

; =========================================================
; Print "Welcome to the DLX factorial program!"
; =========================================================
        ADDI R6, R0, 0             ; data offset = 0
        ADDI R7, R0, 0             ; loop counter = 0
        ADDI R8, R0, 37            ; string length = 37
        ADDI R20, R0, 10           ; newline character
        ADDI R21, R0, 13           ; newline character

titleloop
        SGEU R15, R7, R8           ; if counter >= length, done
        BNEZ R15, titleend
        LW R10, s1(R6)
        ADDI R6, R6, 1
        ADDI R7, R7, 1
	PCH R10
        J       titleloop
titleend
        PCH R20                     ; print newline
        PCH R21                    ; newline character

; =========================================================
; Print "Enter a number: "
; =========================================================
        ADDI R6, R0, 0             ; data offset = 0
        ADDI R7, R0, 0             ; loop counter = 0
        ADDI R8, R0, 16            ; string length = 16
promptloop
        SGEU R15, R7, R8
        BNEZ R15, promptend
        LW R10, s2(R6)
        ADDI R6, R6, 1
        ADDI R7, R7, 1
	PCH R10
        J       promptloop
; =========================================================
; Read integer from keyboard
; =========================================================
promptend
        GDU R1                      ; R1 = user input (unsigned)

        TR
        TGO

        PDU R1                      ; Print what user inputted
        PCH R20                     ; print newline
        PCH R21                    ; newline character

; =========================================================
; Compute factorial of R1
; =========================================================
        ADD     R5, R1, R0         ; value = n
        ; 0! and 1! case
        BEQZ    R5, onecase        ; if n == 0 -> factorial = 1
        SUBI    R5, R5, 1          ; value = n - 1
        BEQZ    R5, onecase        ; if n == 1 -> factorial = 1
        ADD     R3, R1, R0         ; result = n
loop1
        ;Reduce value
        SUBI    R5, R5, 1          ; value--
        ;make count be same as value
        ADD     R4, R5, R0         ; count = value
        ADDI     R4, R4, 1
        ;if value is 0, we're done
        BEQZ    R5, done
        ;Make hold same as result
        ADD     R2, R3, R0         ; hold = result (save old result)
        ;Function to multiply result
        JAL     f_multiply         ; result = result * count (via repeated add)
        J       loop1              ; continue outer loop (next multiply)
; ---------------------------------------------------------
; f_multiply
; Multiply result (R3) by current count (R4)
; by adding hold (R2) count times
; On entry:  R2 = hold (old result), R3 = result (old), R4 = count
; On exit:   R3 = result * count
; Returns with JR R31.
; ---------------------------------------------------------
f_multiply
        ;add hold to result
        ADD     R3, R3, R2         ; result += hold
        ;reduce count
        SUBI    R4, R4, 2          ; count -= 2  (paired with fix to net -1)
        ;checks if count is one / done multiplying
        BNEZ    R4, fix            ; if count != 0, keep going
        JR      R31                ; if count == 0, return to caller
fix
        ADDI    R4, R4, 1          ; net effect: count--
        J       f_multiply         ; keep multiplying (repeated addition)
onecase
        ADDI    R3, R0, 1          ; factorial(0) or factorial(1) = 1
        J       done
; =========================================================
; Print result: "N! = RESULT"
; =========================================================
done
        ;SW      f(R0), R3          ; store factorial result
        ;NOP
        ;NOP
        ;NOP
        ;NOP

        PDU R1                      ; print input number
        ; Print "! = "
        ADDI R6, R0, 0
        ADDI R7, R0, 0
        ADDI R8, R0, 4
seploop
        SGEU R15, R7, R8
        BNEZ R15, printresult
        LW R10, s3(R6)
        ADDI R6, R6, 1
        ADDI R7, R7, 1
	PCH R10
        J       seploop
printresult
        ;LW R3, f(R0)               ; reload factorial result
        ;NOP
        ;NOP
        ;NOP
        ;NOP

        PDU R3                      ; print factorial result
        PCH R20                     ; print newline
        PCH R21                    ; newline character

        TSP

end
        J end
